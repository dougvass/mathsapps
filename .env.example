# Bootstrap password for the /admin product editor, and the secret used to
# sign the admin session cookie - keep it secret, and keep it set even after
# changing the login password from the admin panel (session signing depends
# on it).
ADMIN_PASSWORD=changeme

# Stripe secret key. Use a TEST key (starts with sk_test_) until you're
# ready to go live: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Stripe publishable key. Safe to expose to the browser. Not required by
# the current redirect-based Checkout flow, but handy to have on hand if
# Stripe.js/Elements are added later.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Fallback base URL used to build Stripe success/cancel redirect links if
# the incoming request has no Origin header. Not required for normal
# browser checkout flows.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set automatically when a Vercel Blob store is connected to the project
# (Storage tab in the Vercel dashboard). Required for admin edits to persist
# on Vercel - without it, the store falls back to the local data/store.json
# file, which is read-only in production.
# BLOB_READ_WRITE_TOKEN=

